{
  "name": "tokenlens",
  "private": true,
  "version": "0.1.1",
  "description": "TokenLens — JWT and Bearer token inspection for Chrome DevTools",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=panel-ui --project=extension",
    "test:e2e:headed": "playwright test --headed --project=extension --project=devtools",
    "test:e2e:devtools": "playwright test --headed --project=devtools",
    "fixture:serve": "node e2e/fixture/server.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:manifest",
    "test:e2e:baselines": "node scripts/visual-baselines.mjs",
    "test:e2e:baselines:check": "node scripts/visual-baselines.mjs --check",
    "verify:manifest": "node scripts/verify-manifest.mjs dist/manifest.json",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:check": "node scripts/release/check-version.mjs",
    "release:package": "node scripts/release/package.mjs --dist dist --out release",
    "release:verify": "node scripts/release/verify-package.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.24",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
