{
  "name": "tokenlens-demo",
  "private": true,
  "description": "Reproducible production of the TokenLens promotional video (not part of the extension build)",
  "type": "module",
  "scripts": {
    "narrate": "node scripts/narrate.mjs",
    "record": "cd .. && node node_modules/@playwright/test/cli.js test -c demo/playwright.config.ts",
    "brand": "node scripts/brand.mjs",
    "edit": "node scripts/edit.mjs",
    "assemble": "node scripts/assemble.mjs",
    "video": "node scripts/build.mjs",
    "inspect": "node scripts/inspect.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "agent-screenplay": "0.1.7",
    "ffmpeg-static": "5.3.0",
    "kokoro-js": "1.2.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
